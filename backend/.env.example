# ---- Core ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=Australia/Melbourne
LOG_LEVEL=INFO

# ---- Database ----
# This project's own Postgres (docker compose up -d db). scripts/setup.sh fills
# this in automatically when Docker is available; leave it unset to fall back to
# a local SQLite file (zero setup).
# DATABASE_URL=postgres://collings_ticketing:collings_ticketing@localhost:5433/collings_ticketing
# DB_SSL_REQUIRE=false

# ---- Auth (JWT) ----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- Frontend origins (CORS + CSRF) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Redis / Celery / Channels (leave unset for in-memory local dev) ----
# This project's own Redis from docker compose maps to host port 6380.
# REDIS_URL=redis://localhost:6380/0
# CELERY_BROKER_URL=redis://localhost:6380/0
# CELERY_RESULT_BACKEND=redis://localhost:6380/0

# ---- S3 media (optional) ----
# USE_S3=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-southeast-2

# ---- Sentry (optional) ----
# SENTRY_DSN=

# ---- Prod only ----
# SECURE_SSL_REDIRECT=true
